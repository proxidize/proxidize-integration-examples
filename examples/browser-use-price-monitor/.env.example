BROWSER_USE_API_KEY=replace-with-a-private-browser-use-key
BROWSER_USE_MODEL=bu-4.0-mini
BROWSER_USE_MAX_COST_USD=1.00
BROWSER_USE_TIMEOUT_SECONDS=300

PROXIDIZE_PROXY_HOST=hostname-from-dashboard
PROXIDIZE_PROXY_PORT=20000
PROXIDIZE_PROXY_PROTOCOL=https
PROXIDIZE_PROXY_PASSWORD=replace-with-a-private-proxy-password

PRICE_MONITOR_TARGET_URL=https://example.com/authorized-product-page
PRICE_MONITOR_PRODUCT_HINT=Exact product name or SKU to observe
PRICE_MONITOR_GEO_URL=https://ipwho.is/
PRICE_MONITOR_ROUTES_FILE=.local/browser-use-price-monitor-routes.json
PRICE_MONITOR_DATABASE=.local/browser-use-price-monitor.sqlite3
