# Choose the HTTPS profile used by cURL, Node.js, Python, Playwright,
# Puppeteer, and Scrapy. Accepted values: mobile or residential.
PROXY_PROFILE=mobile

# Copy the complete server value shown by the mobile HTTPS access point.
MOBILE_HTTPS_PROXY_SERVER=https://hostname-from-dashboard:port
MOBILE_HTTPS_PROXY_USERNAME=username-from-dashboard
MOBILE_HTTPS_PROXY_PASSWORD=password-from-dashboard

# Residential Per GB HTTPS access point.
RESIDENTIAL_HTTPS_PROXY_SERVER=https://hostname-from-dashboard:port
RESIDENTIAL_HTTPS_PROXY_USERNAME=username-from-dashboard
RESIDENTIAL_HTTPS_PROXY_PASSWORD=password-from-dashboard

# Mobile SOCKS5 access point with UDP enabled. The UDP example needs the
# host and port separately for the SOCKS5 control and UDP relay protocol.
MOBILE_SOCKS5_PROXY_HOST=hostname-from-dashboard
MOBILE_SOCKS5_PROXY_PORT=port-from-dashboard
MOBILE_SOCKS5_PROXY_USERNAME=username-from-dashboard
MOBILE_SOCKS5_PROXY_PASSWORD=password-from-dashboard

# Optional test controls.
IP_CHECK_URL=https://api.ipify.org?format=json
TARGET_URL=https://example.com
REQUEST_TIMEOUT_SECONDS=30
NAVIGATION_TIMEOUT_MS=30000

# Set only in an already-isolated container that cannot provide a Chromium
# sandbox. Leave false on normal hosts.
PUPPETEER_NO_SANDBOX=false

# UDP-over-SOCKS5 probe. Use an approved QUIC endpoint on port 443 when
UDP_TARGET_HOST=cloudflare.com
UDP_TARGET_PORT=443
UDP_TIMEOUT_SECONDS=15

# Selenium's standard proxy capability requires an IP-allowlisted endpoint.
SELENIUM_PROXY_SERVER=https://hostname-from-dashboard:port
